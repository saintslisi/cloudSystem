# ==============================================================================
# CONFIGURAZIONE LOCALE PROGETTO
# Copia questo file in `project_config.env` (ignorato da git) e compila i campi.
# Questo file viene letto da `deploy_cloud.sh` per l'automazione.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PERCORSI DATI LOCALI (Hard Disk Privato)
# Definisci il path assoluto della cartella dei modelli pesanti da caricare su S3.
# (es. /media/santi/.../Progetto/data)
# ------------------------------------------------------------------------------
LOCAL_DATA_DIR=""

# Nome del bucket S3 creato da Terraform (deve combaciare con l'infrastruttura AWS)
AWS_S3_BUCKET_NAME="sistemi-cloud-data-santi"

# ------------------------------------------------------------------------------
# 2. CREDENZIALI CLUSTER UNIVERSITARIO (HPC)
# Queste credenziali verranno iniettate in automatico in Kubernetes per far
# comunicare il VLM con il cluster universitario, mantenendole segrete.
# ------------------------------------------------------------------------------
CLUSTER_USER=""
CLUSTER_HOST=""
# IMPORTANTE: Usa i singoli apici ('') per la password, non i doppi (""). 
# I doppi apici causerebbero l'espansione di caratteri speciali come $$ in Bash!
CLUSTER_PW=''

# ------------------------------------------------------------------------------
# 3. GITHUB ACTIONS AUTOMATION
# ------------------------------------------------------------------------------
# Il nome della tua repository (es. username/repo) su cui far partire le Actions.
GITHUB_REPO_NAME="saintslisi/cloudsystem"
